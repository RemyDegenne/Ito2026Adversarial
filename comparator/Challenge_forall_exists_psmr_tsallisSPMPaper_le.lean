    IsProbabilityMeasure (weightedMeasure p) := sorry

/-- The map `p ↦ weightedMeasure p` is measurable. -/
lemma measurable_weightedMeasure : Measurable (weightedMeasure (ι := ι)) := sorry

end MeasureTheory
