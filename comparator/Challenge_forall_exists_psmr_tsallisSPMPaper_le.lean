-- ═══ Ito2026Adversarial.Mathlib.Analysis.Convex.Simplex ═══
@[expose] public section
open MeasureTheory
namespace Learning
variable {ι : Type*} [Fintype ι]

/-- The probability simplex `{p | ∀ i, 0 ≤ p i, ∑ i, p i = 1}` of `EuclideanSpace ℝ ι`. -/
def simplex (ι : Type*) [Fintype ι] : Set (EuclideanSpace ℝ ι) :=
  {p | (∀ i, 0 ≤ p i) ∧ ∑ i, p i = 1}

/-- A point of the simplex is a function on `ι`: `p i` is its `i`-th coordinate. -/
instance instCoeFunElemEuclideanSpaceRealSimplexForall : CoeFun (simplex ι) (fun _ ↦ ι → ℝ) := ⟨fun p ↦ (p : EuclideanSpace ℝ ι).ofLp⟩

@[fun_prop]
lemma measurable_coe_simplex : Measurable fun p : simplex ι ↦ (p : ι → ℝ) := sorry

/-- The uniform distribution `(1/|ι|, …, 1/|ι|)` of `EuclideanSpace ℝ ι`. -/
noncomputable def uniformVec (ι : Type*) [Fintype ι] : EuclideanSpace ℝ ι :=
  (EuclideanSpace.equiv ι ℝ).symm fun _ ↦ (Fintype.card ι : ℝ)⁻¹

lemma uniformVec_mem_simplex [Nonempty ι] : uniformVec ι ∈ simplex ι := sorry

/-- The uniform distribution, as an element of the simplex. -/
noncomputable def uniformSimplex (ι : Type*) [Fintype ι] [Nonempty ι] : simplex ι :=
  ⟨uniformVec ι, uniformVec_mem_simplex⟩

instance instNonemptyElemEuclideanSpaceRealSimplex [Nonempty ι] : Nonempty (simplex ι) := ⟨uniformSimplex ι⟩

end Learning
end

-- ═══ Ito2026Adversarial.Mathlib.MeasureTheory.Measure.Weighted ═══
