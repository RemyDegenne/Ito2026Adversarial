\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{macro/letters}
\RequirePackage{expl3, xparse, etoolbox}

% This package automatically generates commands for common letter modifiers (e.g. \xhat, \calE) for the entire English alphabet, as well as Greek letters.

% https://tex.stackexchange.com/questions/564216/newcommand-for-each-letter
% https://www.alanshawn.com/latex3-tutorial/#preface
% https://tex.stackexchange.com/questions/477180/loop-over-greek-letters-with-pgffor
\ExplSyntaxOn

% Helper function for defining commands
\cs_new_protected:Nn \letter_define:TnnNN
{
  % #1: append text T/F,
  % #2: text to be prepend/appended
  % #3: base character(s) with correct encoding
  % #4: command to use
  % #5: how to treat arg3 (as command or reg text, should either be \use:n or \use:c)
  
  % Either prepend or append the text, save to l_tmpb_tl
  \tl_set:Nx\l_tmpb_tl{
  \IfBooleanTF#1{#3 #2}{#2 #3}
  }
    % Won't overwrite already defined symbols
    \ifcsdef{\l_tmpb_tl}{}{
      % Define new command, don't expand the given command
      \cs_new_protected:cpx { \l_tmpb_tl }{\exp_not:N #4{#5{#3}}}  
    }
}

\NewDocumentCommand{\definealphabet}{ s m m o }{
  % #1: star (no star:prepend, star:append text)
  % #2: text to be prepended/appended
  % #3: command
  % #4: Optional: uppercase only (no Greek)
  
  \int_step_inline:nnn { `A } { `Z }
  {
    % Put correctly encoded base character in l_tmpa_tl
    \letter_define:TnnNN { #1 }{ #2 }{ \char_generate:nn { ##1 }{ 11 } }{ #3 }{\use:n}
    \IfNoValueTF{#4}{
      % Also do lowercase character
      \letter_define:TnnNN { #1 }{ #2 }{ \char_generate:nn { ##1 +32 }{ 11 } }{ #3 }{\use:n}
    }{}
  }
  % Greek characters
  \clist_map_inline:nn{
    Gamma,Delta,Theta,Lambda,Xi,Pi,Sigma,Phi,Psi,Omega,alpha,beta,gamma,delta,epsilon,zeta,eta,theta,iota,kappa,lambda,mu,nu,xi,pi,rho,sigma,tau,phi,chi,psi,omega}{
    \letter_define:TnnNN { #1 }{ #2 }{ ##1 }{ #3 }{\use:c}
  }
}  
\ExplSyntaxOff

% prepended commands .g. \bbR, \calA, \bfe
\definealphabet{bf}{\mathbf}
\definealphabet{bb}{\mathbb}[upper]
\definealphabet{cal}{\mathcal}[upper]
\definealphabet{frak}{\mathfrak}[upper]
% appended commands e.g. \xstar, \Ahat
\newcommand{\starred}[1]{#1_\star}
\definealphabet*{star}{\starred}
\definealphabet*{hat}{\widehat}
\definealphabet*{tilde}{\widetilde}
\definealphabet*{bar}{\overline}