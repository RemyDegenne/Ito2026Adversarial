%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% CUSTOM LETTER: \simplex
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% \newcommand{\simplex}{\Delta}

\newsavebox{\simplexBox}
\sbox{\simplexBox}{%
  \begin{tikzpicture}[baseline=0, line join=round, line cap=round]
    \coordinate (A) at (0.4ex,0);
    \coordinate (B) at (1.6ex, 0.2ex);
    \coordinate (C) at (0.8ex, 1.6ex);
    \coordinate (Back) at (0, 0.3ex); 

    \draw[line width=0.12ex] (A) -- (B) -- (C) -- (Back) -- cycle;
    \draw[line width=0.09ex] (A) -- (C);
  \end{tikzpicture}%
}

\newcommand{\simplex}{%
  \mathchoice
    {\buildSimplex{\displaystyle}{1}}
    {\buildSimplex{\textstyle}{1}}
    {\buildSimplex{\scriptstyle}{0.7}}     % Subscript
    {\buildSimplex{\scriptscriptstyle}{0.5}} % Sub-subscript
}

% Helper macro
% Overlays the simplex symbol over the regular \Delta (transparent), so you can select and copy the symbol
% #1 = Math style (e.g., \scriptstyle)
% #2 = Scale factor
\newcommand{\buildSimplex}[2]{%
  \mathord{% Use \mathord so it spaces like a variable, not a binary operator
    \ooalign{%
      % LAYER 1: The invisible Delta
      % We explicitely pass "#1" so the hidden Delta shrinks correctly in subscripts.
      \texttransparent{0}{$#1\Delta$}\cr
      % LAYER 2: The graphic
      % \hidewidth centers the graphic relative to the Delta
      \hidewidth
      \scalebox{#2}{\usebox{\simplexBox}}%
      \hidewidth
      \cr
    }%
  }%
}
