@inproceedings{neu2020efficient,
  title = {Efficient and Robust Algorithms for Adversarial Linear Contextual Bandits},
  booktitle = {Proceedings of {{Thirty Third Conference}} on {{Learning Theory}}},
  author = {Neu, Gergely and Olkhovskaya, Julia},
  year = 2020,
  month = jul,
  pages = {3049--3068},
  publisher = {PMLR},
  issn = {2640-3498},
  abstract = {We consider an adversarial variant of the classic KKK-armed linear contextual bandit problem where the sequence of loss functions associated with each arm are allowed to change without restriction over time. Under the assumption that the ddd-dimensional contexts are generated i.i.d.~at random from a known distribution, we develop computationally efficient algorithms based on the classic Exp3 algorithm. Our first algorithm, RealLinExp3, is shown to achieve a regret guarantee of O\texttildelow (KdT----\textsurd )O\textasciitilde (KdT)\textbackslash widetilde\textbraceleft O\textbraceright (\textbackslash sqrt\textbraceleft KdT\textbraceright ) over TTT rounds, which matches the best known lower bound for this problem. Our second algorithm, RobustLinExp3, is shown to be robust to misspecification, in that it achieves a regret bound of O\texttildelow ((Kd)1/3T2/3)+{$\varepsilon$}d--\textsurd TO\textasciitilde ((Kd)1/3T2/3)+{$\varepsilon$}dT\textbackslash widetilde\textbraceleft O\textbraceright ((Kd)\textasciicircum\textbraceleft 1/3\textbraceright T\textasciicircum\textbraceleft 2/3\textbraceright ) + \textbackslash varepsilon \textbackslash sqrt\textbraceleft d\textbraceright{} T if the true reward function is linear up to an additive nonlinear error uniformly bounded in absolute value by {$\varepsilon\varepsilon\backslash$}varepsilon. To our knowledge, our performance guarantees constitute the very first results on this problem setting.},
  langid = {english}
}
